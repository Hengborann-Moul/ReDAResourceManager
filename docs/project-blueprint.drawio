"geometry" /></mxCell><mxCell id="c47" value="⚠️ The lab master node is temporarily offline.&lt;br/&gt;Your power-on is queued and will run automatically as soon as it reconnects." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=6;fillColor=#F5F5F5;strokeColor=#B3B3B3;fontSize=10;arcSize=8;" vertex="1" parent="c45"><mxGeometry x="8" y="34" width="250" height="66" as="geometry" /></mxCell><mxCell id="c48" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82b366;arcSize=4;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="990" y="539" width="300" height="205" as="geometry" /></mxCell><mxCell id="c49" value="&lt;b&gt;ACTIVE — SSH details (FR-20)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;arcSize=4;" vertex="1" parent="c48"><mxGeometry x="0" y="0" width="300" height="26" as="geometry" /></mxCell><mxCell id="c50" value="🟢 PC-H1 is ready!&lt;br/&gt;&lt;br/&gt;IP: 100.64.0.11&lt;br/&gt;User: labuser&lt;br/&gt;Slot: 14:00 → 16:00&lt;br/&gt;&lt;br/&gt;How to connect:&lt;br/&gt;ssh labuser@100.64.0.11&lt;br/&gt;&lt;br/&gt;Your registered key is installed for this slot only." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=6;fillColor=#F5F5F5;strokeColor=#B3B3B3;fontSize=10;arcSize=8;" vertex="1" parent="c48"><mxGeometry x="8" y="34" width="250" height="157" as="geometry" /></mxCell><mxCell id="c51" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#d6b656;arcSize=4;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="0" y="774" width="300" height="101" as="geometry" /></mxCell><mxCell id="c52" value="&lt;b&gt;Slot-end warning (FR-22)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;arcSize=4;" vertex="1" parent="c51"><mxGeometry x="0" y="0" width="300" height="26" as="geometry" /></mxCell><mxCell id="c53" value="⏰ 10 minutes left on PC-H1.&lt;br/&gt;Save your work — automatic shutdown at 16:00." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=6;fillColor=#F5F5F5;strokeColor=#B3B3B3;fontSize=10;arcSize=8;" vertex="1" parent="c51"><mxGeometry x="8" y="34" width="250" height="53" as="geometry" /></mxCell><mxCell id="c54" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#d6b656;arcSize=4;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="330" y="774" width="300" height="140" as="geometry" /></mxCell><mxCell id="c55" value="&lt;b&gt;Overrun grace (FR-24, EC-3)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;arcSize=4;" vertex="1" parent="c54"><mxGeometry x="0" y="0" width="300" height="26" as="geometry" /></mxCell><mxCell id="c56" value="⚠️ Your slot ended but you're still connected.&lt;br/&gt;15-minute grace granted — after that the PC is force-shut.&lt;br/&gt;Need more time? Ask an admin for an extension." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=6;fillColor=#F5F5F5;strokeColor=#B3B3B3;fontSize=10;arcSize=8;" vertex="1" parent="c54"><mxGeometry x="8" y="34" width="250" height="92" as="geometry" /></mxCell><mxCell id="c57" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#82b366;arcSize=4;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="660" y="774" width="300" height="114" as="geometry" /></mxCell><mxCell id="c58" value="&lt;b&gt;COMPLETED (UC-4)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;arcSize=4;" vertex="1" parent="c57"><mxGeometry x="0" y="0" width="300" height="26" as="geometry" /></mxCell><mxCell id="c59" value="🏁 Session complete.&lt;br/&gt;PC-H1 has shut down and your key was removed.&lt;br/&gt;Thanks — see you next time!" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=6;fillColor=#F5F5F5;strokeColor=#B3B3B3;fontSize=10;arcSize=8;" vertex="1" parent="c57"><mxGeometry x="8" y="34" width="250" height="66" as="geometry" /></mxCell><mxCell id="c60" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#d6b656;arcSize=4;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="990" y="774" width="300" height="101" as="geometry" /></mxCell><mxCell id="c61" value="&lt;b&gt;COMPLETED_OVERRUN&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;arcSize=4;" vertex="1" parent="c60"><mxGeometry x="0" y="0" width="300" height="26" as="geometry" /></mxCell><mxCell id="c62" value="🏁 Session ended (overrun).&lt;br/&gt;Grace expired with an active session — PC-H1 was force-shut and your key removed." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=6;fillColor=#F5F5F5;strokeColor=#B3B3B3;fontSize=10;arcSize=8;" vertex="1" parent="c60"><mxGeometry x="8" y="34" width="250" height="53" as="geometry" /></mxCell><mxCell id="c63" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#b85450;arcSize=4;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="0" y="944" width="300" height="127" as="geometry" /></mxCell><mxCell id="c64" value="&lt;b&gt;NO_SHOW (FR-26, EC-2)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;arcSize=4;" vertex="1" parent="c63"><mxGeometry x="0" y="0" width="300" height="26" as="geometry" /></mxCell><mxCell id="c65" value="😴 No SSH login within 20 minutes of power-on.&lt;br/&gt;Booking #b-1024 released, PC-H1 powered off.&lt;br/&gt;Note: 3 no-shows in 30 days → 7-day booking cooldown (BR-4)." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=6;fillColor=#F5F5F5;strokeColor=#B3B3B3;fontSize=10;arcSize=8;" vertex="1" parent="c63"><mxGeometry x="8" y="34" width="250" height="79" as="geometry" /></mxCell><mxCell id="c66" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#b85450;arcSize=4;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="330" y="944" width="300" height="127"